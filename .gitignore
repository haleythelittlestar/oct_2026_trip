# ============================================================================
# This repo IS the deployed site. GitHub Pages serves whatever is committed
# here, so anything committed is public and anything ignored simply will not
# exist on the live site.
#
# Keep in mind what must stay tracked:
#   index.html, option.html, config.js, .nojekyll
#   assets/           stylesheet, scripts, favicon
#   locations/        registry.js, each data.js + photos.js + photos/*.jpg
#
# The photos in locations/*/photos/ MUST be committed. They are the site's
# images, not build artefacts — ignoring them would leave every card showing
# the SVG illustration instead.
# ============================================================================

# --- Working notes, not part of the site ------------------------------------
# The research document the trip was planned from. Superseded: the per-location
# data files are now the source of content, and the site no longer links to it.
ideas.md


# --- Generated by tools/ ----------------------------------------------------
# The photo pipeline's run log. Regenerated on every run; no reason to version
# a transcript.
tools/fetch_report.txt

# Backdrop previews from tools/preview_backdrop.py. Regenerate on demand with
#   python tools\preview_backdrop.py [--dark]
tools/backdrop_preview*.svg

# Scratch files. Everything transient in tools/ is prefixed with an underscore
# by convention, so one rule covers the lot.
tools/_*


# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python


# --- OneDrive / Windows ----------------------------------------------------
# This workspace lives inside OneDrive, which scatters these about.
desktop.ini
Thumbs.db
ehthumbs.db
*.tmp
~$*
.~lock.*


# --- macOS / Linux ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*


# --- Editors ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace


# --- Things that should never appear here ----------------------------------
# There is no build step and no backend, so any of these showing up means
# something went wrong. Guarded rather than assumed.
node_modules/
package-lock.json
yarn.lock
dist/
build/
.cache/

# Credentials. Nothing in this project needs a key — if you later wire up the
# Unsplash API, the key belongs in an environment variable, never in a file
# here, because this repo is public.
.env
.env.*
*.key
*.pem
secrets.json


# --- Large originals -------------------------------------------------------
# If you keep full-resolution versions of your own photos, park them here and
# they stay out of the repo. Only the resized copies in locations/*/photos/
# need to ship.
_originals/
*.psd
*.RAW
*.CR2
*.NEF
*.dng
